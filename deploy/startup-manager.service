# Linux counterpart of the Windows scheduled task + run-hidden.ps1.
#
#   sudo cp deploy/startup-manager.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now startup-manager
#
# Adjust User and WorkingDirectory. Run it as a normal user, not root: the
# programs it launches inherit that account, and tmux sessions belong to it.
[Unit]
Description=Startup Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/opt/startup-manager
Environment=NODE_ENV=production
EnvironmentFile=-/opt/startup-manager/.env
ExecStart=/usr/bin/node dist/server.js
# The server handles SIGTERM and shuts down cleanly; tmux sessions survive.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
