# Startup Manager Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=production

# Security Configuration
ADMIN_USERNAME=admin
# IMPORTANT: Change this password in production!
ADMIN_PASSWORD=changeme-in-production
# Add allowed domains for CORS, comma-separated
ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting: max FAILED logins per IP per window (successful logins reset it)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=20

# Logging Configuration
# Available log levels: error, warn, info, http, debug
LOG_LEVEL=info
# Set to true to enable file logging
LOG_TO_FILE=true
LOG_DIR=logs
# Log rotation settings
LOG_ROTATE_MAX_SIZE=10m
LOG_ROTATE_MAX_FILES=7d

# Program Configuration
# Path to the programs configuration file
CONFIG_PATH=./programs.json


# tmux Configuration
# Programs run inside tmux sessions (tmux 2.1+).
#
# Linux/macOS: leave TMUX_PATH and TMUX_SHELL unset. `tmux` is taken from PATH
# and sessions use tmux's default-shell, i.e. your login shell.
#
# Windows: point TMUX_PATH at a Cygwin/MSYS tmux.exe. Running install-tmux.bat
# downloads the itmux bundle and fills this in for you, e.g.:
# TMUX_PATH=C:/ProgramFilesFolder/itmux/bin/tmux.exe
#
# TMUX_SHELL overrides the shell run inside each tmux session. On Windows it
# defaults to the bash.exe sitting next to tmux.exe, non-login, because the
# Cygwin login shell resets PATH and hides every Windows tool:
# TMUX_SHELL=/cygdrive/c/ProgramFilesFolder/itmux/bin/bash.exe --norc -i
#
# SHELL is the shell used by the web terminal's "new terminal" button.
# On Linux/macOS it is your login shell (fallback: bash). On Windows a POSIX
# value such as /usr/bin/bash - what Git Bash exports - is ignored and
# powershell.exe is used, since node-pty can only spawn Windows executables.
# SHELL=powershell.exe
