# Startup Manager Configuration
# Copy this file to .env and customize for your environment

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=production

# Security Configuration
ADMIN_USERNAME=admin
# IMPORTANT: Change this password in production!
ADMIN_PASSWORD=changeme-in-production
# Add allowed domains for CORS, comma-separated
ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting: max FAILED logins per IP per window (successful logins reset it)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=20

# Logging Configuration
# Available log levels: error, warn, info, http, debug
LOG_LEVEL=info
# Set to true to enable file logging
LOG_TO_FILE=true
LOG_DIR=logs
# Log rotation settings
LOG_ROTATE_MAX_SIZE=10m
LOG_ROTATE_MAX_FILES=7d

# Program Configuration
# Path to the programs configuration file
CONFIG_PATH=./programs.json


# tmux Configuration
# Programs run inside tmux sessions. On Linux/macOS leave unset (uses `tmux` on PATH).
# On Windows point this at a Cygwin/MSYS tmux.exe, e.g.:
# TMUX_PATH=C:/ProgramFilesFolder/itmux/bin/tmux.exe
# TMUX_PATH=tmux
# Shell command run inside each tmux session (default on Windows: the bundled bash.exe, non-login)
# TMUX_SHELL=/cygdrive/c/ProgramFilesFolder/itmux/bin/bash.exe --norc -i
# Shell used by the web terminal's "new terminal" (defaults: bash, or powershell.exe on Windows)
# SHELL=powershell.exe
