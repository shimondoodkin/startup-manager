# Startup Manager configuration - Windows
#
# Copy to .env and edit:   copy .env.example.windows .env
# install-tmux.bat does this for you and fills in TMUX_PATH.

# --- Server ---
PORT=3000
HOST=localhost
NODE_ENV=production

# --- Security ---
ADMIN_USERNAME=admin
# IMPORTANT: change this before the server is reachable from anywhere but localhost.
ADMIN_PASSWORD=changeme-in-production
# Allowed CORS origins, comma-separated. Must match the URL you open the UI on.
ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting: max FAILED logins per IP per window (a success resets it).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=20

# --- Logging ---
# error | warn | info | http | debug
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs
LOG_ROTATE_MAX_SIZE=10m
LOG_ROTATE_MAX_FILES=7d

# --- Programs ---
# Where the program list is stored. Defaults to
# %USERPROFILE%\.startup-manager\programs.json when unset.
# config.windows.json is a working starting point - note it avoids `sleep`,
# which the itmux bundle does not ship.
CONFIG_PATH=./programs.json

# --- tmux ---
# Windows has no tmux package. Run install-tmux.bat to download the itmux
# bundle into tools\itmux and set this line for you. Use forward slashes.
# TMUX_PATH=C:/Users/you/startup-manager/tools/itmux/bin/tmux.exe

# Shell run inside each tmux session. Defaults to the bash.exe sitting next to
# tmux.exe, started with --norc so it inherits the real PATH rather than the
# Cygwin login shell's stripped-down one. The bundle's bin directory is
# prepended automatically, so Cygwin tools and Windows tools are both
# reachable. Override this only for a different Cygwin/MSYS install:
# TMUX_SHELL=/cygdrive/c/cygwin64/bin/bash.exe --norc -i

# Shell for the web terminal's "new terminal" button. Must be a Windows
# executable: a POSIX value like /usr/bin/bash, which Git Bash exports, is
# ignored because node-pty cannot spawn it.
# SHELL=powershell.exe
