# Startup Manager configuration - Linux / macOS
#
# Copy to .env and edit:   cp .env.example.linux .env
# ./start-manager.sh does this for you when .env is missing.

# --- Server ---
PORT=3000
HOST=localhost
NODE_ENV=production

# --- Security ---
ADMIN_USERNAME=admin
# IMPORTANT: change this before the server is reachable from anywhere but localhost.
ADMIN_PASSWORD=changeme-in-production
# Allowed CORS origins, comma-separated. Must match the URL you open the UI on.
ALLOWED_ORIGINS=http://localhost:3000
# Rate limiting: max FAILED logins per IP per window (a success resets it).
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=20

# --- Logging ---
# error | warn | info | http | debug
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs
LOG_ROTATE_MAX_SIZE=10m
LOG_ROTATE_MAX_FILES=7d

# --- Programs ---
# Where the program list is stored. Defaults to ~/.startup-manager/programs.json
# when unset. config.linux.json is a working starting point.
CONFIG_PATH=./programs.json

# --- tmux ---
# Nothing to set here: `tmux` is taken from PATH, and sessions use tmux's
# default-shell, which is your login shell. Install it with the package manager:
#   sudo apt install tmux    sudo dnf install tmux    brew install tmux
#
# Only if tmux lives somewhere unusual:
# TMUX_PATH=/usr/local/bin/tmux
#
# Only to run programs under a shell other than your login shell:
# TMUX_SHELL=/bin/bash
#
# Shell for the web terminal's "new terminal" button. Defaults to $SHELL,
# falling back to bash.
# SHELL=/bin/bash
